# Patterns to ignore when building packages.
# This supports shell glob matching, relative path matching, and
# negation (prefixed with !). Only one pattern per line.
.DS_Store
# Common VCS dirs
.git/
.gitignore
.bzr/
.bzrignore
.hg/
.hgignore
.svn/
# Common backup files
*.swp
*.bak
*.tmp
*.orig
*~
# Various IDEs
.project
.idea/
*.tmproj
.vscode/
README.md
# NOTE: do not add charts/ here. .helmignore is applied by Helm's chart *loader*, not
# just when packaging, so ignoring charts/ makes any resolved subchart invisible to
# `helm template`/`helm install` and the chart silently fails to render. artie00 has no
# subcharts today, but this is an easy trap to fall back into.
