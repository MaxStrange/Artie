# Dockerfile for Artie CAN library test image
# This image contains the CAN library source code and test suite for unit testing

ARG ARTIE_BASE_IMG=artie/ardk-base:latest
FROM ${ARTIE_BASE_IMG}

# Create directory for artie-can
RUN mkdir -p /artie-can
WORKDIR /artie-can

# Copy the entire artie-can library (source + tests)
COPY . ./

# Build the C library stand-alone (for testing the C API), along with the Unity test suite.
# Docs are off: Doxygen isn't installed in the base image and the tests don't need it.
# Logging is off as well: the test task scrapes this container's logs for each test's
# result line, and the library's debug logging would bury those lines in noise.
RUN cmake -S . -B build \
        -DCMAKE_BUILD_TYPE=Release \
        -DBUILD_TESTS=ON \
        -DBUILD_DOCS=OFF \
    && cmake --build build --parallel

# The Python package (src/artie_can) is already installed by the base image - the base image
# rebuilds whenever this library changes - so only the test runner is missing.
RUN --mount=type=cache,target=/root/.cache/pip pip install "pytest>=7.0"

WORKDIR /artie-can/build

# Default command runs the whole C test suite. -V is what makes each Unity test's
# '<file>:<line>:<test-name>:PASS' line show up in the container's logs, which is what
# the artie-can-unit-tests task greps for on a per-test basis.
#
# The Python suites override this: artie-can-python-unit-tests runs '/artie-can/run_tests.py',
# and can-python-integration-tests runs '/artie-can/itest/itest_node.py'.
CMD ["ctest", "-V"]
